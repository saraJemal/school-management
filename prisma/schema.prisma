generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id
  username  String   @unique
  createdAt DateTime @default(now())
}

model Student {
  id          String              @id
  username    String              @unique
  name        String
  surname     String
  email       String?             @unique
  phone       String?             @unique
  address     String
  img         String?
  bloodType   String
  sex         UserSex
  createdAt   DateTime            @default(now())
  parentId    String?
  classId     Int
  gradeId     Int
  birthday    DateTime
  attendances Attendance[]
  assessments StudentAssessment[]
  enrollments StudentEnrollment[]
  class       Class               @relation(fields: [classId], references: [id])
  grade       Grade               @relation(fields: [gradeId], references: [id])
  parent      Parent?             @relation(fields: [parentId], references: [id], onDelete: SetNull)
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  img       String?
  bloodType String
  sex       UserSex
  createdAt DateTime  @default(now())
  sectionSupervisor SectionSupervisor?
  birthday  DateTime
  classes   Class[]
  lessons   Lesson[]
  subjects  Subject[] @relation("SubjectToTeacher")
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
}

model Grade {
  id          Int          @id @default(autoincrement())
  level       Int          @unique
  name        String       @unique
  section     GradeSection
  classes     Class[]
  students    Student[]
  assessments Assessment[]
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  enrollments StudentEnrollment[]
  assessments Assessment[]
  resultSubmissions ResultSubmission[]
}

model StudentEnrollment {
  id             Int    @id @default(autoincrement())
  studentId      String
  academicYearId Int
  classId        Int
  rollNumber     Int

  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])

  @@unique([studentId, academicYearId])
  @@unique([classId, academicYearId, rollNumber])
}

model Class {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  capacity          Int
  homeRoomTeacherId String?
  gradeId           Int
  announcements     Announcement[]
  grade             Grade               @relation(fields: [gradeId], references: [id])
  homeRoomTeacher   Teacher?            @relation(fields: [homeRoomTeacherId], references: [id], map: "Class_supervisorId_fkey")
  events            Event[]
  lessons           Lesson[]
  students          Student[]
  enrollments       StudentEnrollment[]
  attendances       Attendance[]
  resultSubmissions ResultSubmission[]
}

model Subject {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  lessons     Lesson[]
  teachers    Teacher[]        @relation("SubjectToTeacher")
  assessments Assessment[]
  sections    SubjectSection[] @relation("SubjectToSection")
  resultSubmissions ResultSubmission[]
}

model SubjectSection {
  id        Int          @id @default(autoincrement())
  subjectId Int
  section   GradeSection

  subject Subject @relation("SubjectToSection", fields: [subjectId], references: [id])

  @@unique([subjectId, section])
}

model Assessment {
  id             Int                @id @default(autoincrement())
  title          String
  type           AssessmentType
  category       AssessmentCategory
  semester       Semester
  academicYearId Int
  gradeId        Int
  subjectId      Int
  maxScore       Float
  weight         Float

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  grade        Grade        @relation(fields: [gradeId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])

  results StudentAssessment[]
  

  @@unique([academicYearId, gradeId, subjectId, semester, type])
}

model StudentAssessment {
  id           Int    @id @default(autoincrement())
  score        Float
  assessmentId Int
  studentId    String

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
}

model ResultSubmission {
  id             Int                    @id @default(autoincrement())
  academicYearId Int
  classId        Int
  subjectId      Int
  semester       Semester
  status         ResultSubmissionStatus @default(DRAFT)
  submittedAt    DateTime?
  submittedById  String?
  resetAt        DateTime?
  resetById      String?

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])

  @@unique([academicYearId, classId, subjectId, semester])
}

model SectionSupervisor {
  id        Int          @id @default(autoincrement())
  section   GradeSection @unique
  teacherId String       @unique

  teacher Teacher @relation(fields: [teacherId], references: [id])
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime
  subjectId Int
  classId   Int
  teacherId String

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  present   Boolean
  studentId String
  classId   Int
  class     Class    @relation(fields: [classId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, classId, date])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum Semester {
  SEMESTER1
  SEMESTER2
}

enum AssessmentCategory {
  CLASS_ACTIVITY
  EXAM
}

enum AssessmentType {
  CW1
  CW2
  HW1
  HW2
  WS1
  WS2
  PROJECT
  EXERCISE_BOOK
  Q1
  Q2
  TEST1
  TEST2
  MIDTERM
  FINAL
}

enum GradeSection {
  KG
  PRIMARY
  MIDDLE
  SECONDARY
  PREPARATORY
}

enum ResultSubmissionStatus {
  DRAFT
  SUBMITTED
}