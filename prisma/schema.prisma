generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                            String       @id
  username                      String       @unique
  createdAt                     DateTime     @default(now())
  clerkUserId                   String?      @unique
  name                          String       @default("")
  middleName                    String?
  surname                       String?
  isManagingDirector            Boolean      @default(false)
  reportCardsAsManagingDirector ReportCard[]

  sentMessages        Message[]             @relation("AdminSentMessages")
  receivedMessages    MessageRecipient[]    @relation("AdminMessageRecipients")
  performanceAnalyses PerformanceAnalysis[]
}

model Student {
  id          String   @id
  username    String   @unique
  name        String
  middleName  String?
  surname     String?
  email       String?  @unique
  phone       String?  @unique
  address     String
  img         String?
  bloodType   String
  sex         UserSex
  createdAt   DateTime @default(now())
  parentId    String?
  birthday    DateTime
  clerkUserId String?  @unique

  attendances Attendance[]
  parent      Parent?             @relation(fields: [parentId], references: [id])
  assessments StudentAssessment[]
  enrollments StudentEnrollment[]
  reportCards ReportCard[]

  communicationBooks  CommunicationBook[]
  performanceAnalyses PerformanceAnalysis[]
}

model Teacher {
  id          String   @id
  username    String   @unique
  name        String
  middleName  String?
  surname     String?
  email       String?  @unique
  phone       String?  @unique
  address     String
  img         String?
  bloodType   String
  sex         UserSex
  createdAt   DateTime @default(now())
  birthday    DateTime
  clerkUserId String?  @unique
  isActive    Boolean  @default(true)

  classes            Class[]
  lessons            Lesson[]
  sectionSupervisor  SectionSupervisor?
  subjects           Subject[]            @relation("SubjectToTeacher")
  ReportCardSemester ReportCardSemester[]

  sentMessages     Message[]          @relation("TeacherSentMessages")
  receivedMessages MessageRecipient[] @relation("TeacherMessageRecipients")
}

model Parent {
  id          String    @id
  username    String    @unique
  name        String
  middleName  String?
  surname     String?
  email       String?   @unique
  phone       String    @unique
  address     String
  createdAt   DateTime  @default(now())
  clerkUserId String?   @unique
  students    Student[]
}

model Grade {
  id          Int          @id @default(autoincrement())
  level       Int          @unique
  name        String       @unique
  section     GradeSection
  assessments Assessment[]
  classes     Class[]

  promotedReportCards ReportCard[] @relation("ReportCardPromotedGrade")
  detainedReportCards ReportCard[] @relation("ReportCardDetainedGrade")

  events        Event[]
  announcements Announcement[]

  performanceAnalyses PerformanceAnalysis[]
}

model AcademicYear {
  id   Int    @id @default(autoincrement())
  name String @unique

  startDate DateTime
  endDate   DateTime

  semester1StartDate DateTime
  semester1EndDate   DateTime
  semester2StartDate DateTime
  semester2EndDate   DateTime

  isCurrent Boolean @default(false)

  assessments       Assessment[]
  resultSubmissions ResultSubmission[]
  enrollments       StudentEnrollment[]
  reportCards       ReportCard[]
  promotionPolicies PromotionPolicy[]

  communicationBooks  CommunicationBook[]
  performanceAnalyses PerformanceAnalysis[]
}

model ReportCard {
  id                        Int      @id @default(autoincrement())
  studentId                 String
  academicYearId            Int
  promotedGradeId           Int?
  detainedGradeId           Int?
  managingDirectorId        String?
  managingDirectorName      String?
  managingDirectorSignature String?
  managingDirectorDate      DateTime @default(now())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  student          Student                @relation(fields: [studentId], references: [id])
  academicYear     AcademicYear           @relation(fields: [academicYearId], references: [id])
  managingDirector Admin?                 @relation(fields: [managingDirectorId], references: [id], onDelete: SetNull)
  promotedGrade    Grade?                 @relation("ReportCardPromotedGrade", fields: [promotedGradeId], references: [id])
  detainedGrade    Grade?                 @relation("ReportCardDetainedGrade", fields: [detainedGradeId], references: [id])
  semesters        ReportCardSemester[]
  basicSkills      ReportCardBasicSkill[]

  @@unique([studentId, academicYearId])
}

model ReportCardSemester {
  id Int @id @default(autoincrement())

  reportCardId Int
  semester     Semester

  homeroomTeacherId        String?
  homeroomTeacherName      String?
  homeroomTeacherSignature String?
  parentName               String?

  comment String?
  conduct String?

  reportCard      ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  homeroomTeacher Teacher?   @relation(fields: [homeroomTeacherId], references: [id])

  @@unique([reportCardId, semester])
}

model ReportCardBasicSkill {
  id           Int      @id @default(autoincrement())
  reportCardId Int
  semester     Semester

  reading          String?
  writing          String?
  spelling         String?
  comprehension    String?
  computation      String?
  punctuality      String?
  uniform          String?
  materialHandling String?
  direction        String?
  completion       String?
  englishUse       String?
  workEthics       String?
  skills           String?
  overallProgress  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)

  @@unique([reportCardId, semester])
}

model PromotionPolicy {
  id                      Int          @id @default(autoincrement())
  academicYearId          Int
  section                 GradeSection
  promotionMinimumAverage Float
  detentionMaximumAverage Float

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, section])
}

model StudentEnrollment {
  id             Int          @id @default(autoincrement())
  studentId      String
  academicYearId Int
  classId        Int
  rollNumber     Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id], onDelete: NoAction)

  @@unique([studentId, academicYearId])
  @@unique([classId, academicYearId, rollNumber])
}

model Class {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  capacity          Int
  homeRoomTeacherId String?
  gradeId           Int
  announcements     Announcement[]
  attendances       Attendance[]
  grade             Grade               @relation(fields: [gradeId], references: [id])
  homeRoomTeacher   Teacher?            @relation(fields: [homeRoomTeacherId], references: [id], map: "Class_supervisorId_fkey")
  events            Event[]
  lessons           Lesson[]
  resultSubmissions ResultSubmission[]
  enrollments       StudentEnrollment[]

  communicationBooks  CommunicationBook[]
  performanceAnalyses PerformanceAnalysis[]
}

model Subject {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  assessments       Assessment[]
  lessons           Lesson[]
  resultSubmissions ResultSubmission[]
  sections          SubjectSection[]   @relation("SubjectToSection")
  teachers          Teacher[]          @relation("SubjectToTeacher")

  communicationBookSubjects   CommunicationBookSubject[]
  performanceAnalysisSubjects PerformanceAnalysisSubject[]
}

model SubjectSection {
  id        Int          @id @default(autoincrement())
  subjectId Int
  section   GradeSection
  subject   Subject      @relation("SubjectToSection", fields: [subjectId], references: [id])

  @@unique([subjectId, section])
}

model Assessment {
  id             Int                 @id @default(autoincrement())
  title          String
  type           AssessmentType
  category       AssessmentCategory
  semester       Semester
  academicYearId Int
  subjectId      Int
  maxScore       Float
  weight         Float
  gradeId        Int
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id])
  grade          Grade               @relation(fields: [gradeId], references: [id])
  subject        Subject             @relation(fields: [subjectId], references: [id])
  results        StudentAssessment[]

  @@unique([academicYearId, gradeId, subjectId, semester, type])
}

model StudentAssessment {
  id           Int        @id @default(autoincrement())
  score        Float
  assessmentId Int
  studentId    String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id], onDelete: NoAction)

  @@unique([assessmentId, studentId])
}

model ResultSubmission {
  id             Int                    @id @default(autoincrement())
  academicYearId Int
  classId        Int
  subjectId      Int
  semester       Semester
  status         ResultSubmissionStatus @default(DRAFT)
  submittedAt    DateTime?
  submittedById  String?
  resetAt        DateTime?
  resetById      String?
  academicYear   AcademicYear           @relation(fields: [academicYearId], references: [id])
  class          Class                  @relation(fields: [classId], references: [id])
  subject        Subject                @relation(fields: [subjectId], references: [id])

  @@unique([academicYearId, classId, subjectId, semester])
}

model SectionSupervisor {
  id        Int          @id @default(autoincrement())
  section   GradeSection @unique
  teacherId String?      @unique
  teacher   Teacher?     @relation(fields: [teacherId], references: [id], onUpdate: NoAction)
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime
  subjectId Int
  classId   Int
  teacherId String
  class     Class    @relation(fields: [classId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  present   Boolean
  studentId String
  classId   Int
  class     Class    @relation(fields: [classId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id], onDelete: NoAction)

  @@unique([studentId, classId, date])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  targetType TargetType    @default(GENERAL)
  section    GradeSection?
  gradeId    Int?
  classId    Int?

  grade Grade? @relation(fields: [gradeId], references: [id])
  class Class? @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  targetType TargetType    @default(GENERAL)
  section    GradeSection?
  gradeId    Int?
  classId    Int?

  grade Grade? @relation(fields: [gradeId], references: [id])
  class Class? @relation(fields: [classId], references: [id])
}

model CommunicationBook {
  id Int @id @default(autoincrement())

  studentId      String
  academicYearId Int
  classId        Int
  date           DateTime

  dailyWord      String?
  characterTrait String?

  teacherComment   String?
  teacherName      String?
  teacherSignature String?

  parentComment   String?
  parentName      String?
  parentSignature String?

  student      Student      @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])

  subjects CommunicationBookSubject[]

  weeklyProgressReport WeeklyProgressReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId, date])
  @@index([studentId, academicYearId])
  @@index([classId, date])
}

model CommunicationBookSubject {
  id Int @id @default(autoincrement())

  communicationBookId Int
  subjectId           Int

  homeworkInstruction String?
  asp                 String?
  parentSignature     String?

  communicationBook CommunicationBook @relation(fields: [communicationBookId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([communicationBookId, subjectId])
  @@index([subjectId])
}

model WeeklyProgressReport {
  id Int @id @default(autoincrement())

  communicationBookId Int @unique

  teacherComment   String?
  teacherName      String?
  teacherSignature String?

  parentComment   String?
  parentName      String?
  parentSignature String?

  communicationBook CommunicationBook @relation(fields: [communicationBookId], references: [id], onDelete: Cascade)

  items WeeklyProgressItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyProgressItem {
  id Int @id @default(autoincrement())

  weeklyProgressReportId Int
  criterion              String
  category               String
  rating                 ProgressRating

  weeklyProgressReport WeeklyProgressReport @relation(fields: [weeklyProgressReportId], references: [id], onDelete: Cascade)

  @@index([weeklyProgressReportId])
}

model Message {
  id Int @id @default(autoincrement())

  senderAdminId   String?
  senderTeacherId String?

  subject String
  body    String

  createdAt DateTime @default(now())

  senderAdmin Admin? @relation("AdminSentMessages", fields: [senderAdminId], references: [id])

  senderTeacher Teacher? @relation("TeacherSentMessages", fields: [senderTeacherId], references: [id])

  recipients MessageRecipient[]
}

model MessageRecipient {
  id Int @id @default(autoincrement())

  messageId Int

  adminId   String?
  teacherId String?

  isRead Boolean   @default(false)
  readAt DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  admin Admin? @relation("AdminMessageRecipients", fields: [adminId], references: [id])

  teacher Teacher? @relation("TeacherMessageRecipients", fields: [teacherId], references: [id])

  @@index([adminId, isRead])
  @@index([teacherId, isRead])
  @@index([messageId])
}

model PerformanceAnalysis {
  id Int @id @default(autoincrement())

  academicYearId Int
  semester       Semester

  // Analysis target
  studentId String?
  classId   Int?
  gradeId   Int?
  section   GradeSection?

  // Historical target snapshot
  studentName String?
  className   String?
  gradeName   String?

  // Historical calculated results
  studentCount Int @default(0)
  maleCount    Int @default(0)
  femaleCount  Int @default(0)

  overallAverage Float?
  highestAverage Float?
  lowestAverage  Float?

  // Historical analysis/comment
  analysisTitle   String?
  analysisComment String?

  // Who created/saved the analysis
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  class        Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  grade        Grade?       @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  createdBy    Admin?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  subjects PerformanceAnalysisSubject[]

  @@index([academicYearId, semester])
  @@index([studentId])
  @@index([classId])
  @@index([gradeId])
  @@index([section])
  @@index([createdById])
}

model PerformanceAnalysisSubject {
  id Int @id @default(autoincrement())

  performanceAnalysisId Int
  subjectId             Int

  studentCount Int @default(0)

  averageScore Float?
  highestScore Float?
  lowestScore  Float?

  maleAverage   Float?
  femaleAverage Float?

  comment String?

  performanceAnalysis PerformanceAnalysis @relation(fields: [performanceAnalysisId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([performanceAnalysisId, subjectId])
  @@index([subjectId])
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum Semester {
  SEMESTER1
  SEMESTER2
}

enum AssessmentCategory {
  CLASS_ACTIVITY
  EXAM
}

enum AssessmentType {
  CW1
  CW2
  HW1
  HW2
  WS1
  WS2
  PROJECT
  EXERCISE_BOOK
  Q1
  Q2
  TEST1
  TEST2
  MIDTERM
  FINAL
}

enum GradeSection {
  KG
  PRIMARY
  MIDDLE
  SECONDARY
  PREPARATORY
}

enum ResultSubmissionStatus {
  DRAFT
  SUBMITTED
}

enum TargetType {
  GENERAL
  SECTION
  GRADE
  CLASS
}

enum ProgressRating {
  EXCELLENT
  VERY_GOOD
  GOOD
  NEEDS_IMPROVEMENT
}
